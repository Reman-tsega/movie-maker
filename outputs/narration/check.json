    "languages": [
      "Amharic"
    ],
    "transcript": "በአንድ ፀሐያማ ቀን ጥንቸልና ኤሊ የሩጫ ውድድር ጀመሩ።",
    "flags": []
  },
  {
    "id": "s02",
    "duration_s": 3.92,
    "languages": [
      "Amharic"
    ],
    "transcript": "ውድድሩ ሲጀምር ጥንቸል በፍጥነት ሮጠች።",
    "flags": []
  },
  {
    "id": "s03",
    "duration_s": 4.52,
    "languages": [
      "Amharic"
    ],
    "transcript": "ወደኋላም ስትመለከት ኤሊ ገና በጣም ሩቅ ነበረች።",
    "flags": []
  },
  {
    "id": "s04",
    "duration_s": 4.96,
    "languages": [
      "Amharic"
    ],
    "transcript": "ጥንቸል በፍጥነቷ በመኩራራት ጊዜ አለኝ ብላ አሰበች።",
    "flags": []
  },
  {
    "id": "s05",
    "duration_s": 7.68,
    "languages": [
      "Amharic"
    ],
    "transcript": "ጥንቸል በአንድ ትልቅ ዛፍ ጥላ ስር ትንሽ ልረፍ ብላ ተኛች፤ ነገር ግን ጥልቅ እንቅልፍ ወሰዳት።",
    "flags": []
  },
  {
    "id": "s06",
    "duration_s": 7.92,
    "languages": [
      "Amharic"
    ],
    "transcript": "በዚህ ጊዜ ኤሊ ሳትቆም ሳትቸኩል እና ዲሲፕሊን ባለው እርምጃ ወደፊት መጓዟን ቀጠለች።",
    "flags": []
  },
  {
    "id": "s07",
    "duration_s": 4.571,
    "languages": [
      "Amharic"
    ],
    "transcript": "ጥንቸል ከእንቅልፍዋ ስትነቃ ጊዜው በጣም ረፍዶ ነበር።",
    "flags": []
  },
  {
    "id": "s08",
    "duration_s": 3.28,
    "languages": [
      "Amharic"
    ],
    "transcript": "ኤሊ የመጨረሻው መስመር አጠገብ ደርሳ ነበር።",
    "flags": []
  },
  {
    "id": "s09",
    "duration_s": 6.84,
    "languages": [
      "Amharic"
    ],
    "transcript": "ጥንቸል በሙሉ ኃይሏ ብትሮጥም ቀድማ መድረስ አልቻለችም፤ ኤሊ ውድድሩን አሸነፈች።",
    "flags": []
  },
  {
    "id": "s10",
    "duration_s": 7.52,
    "languages": [
      "Amharic"
