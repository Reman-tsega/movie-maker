    "duration_s": 3.511,
    "languages": [
      "amharic"
    ],
    "transcript": "ውድድሩ ሲጀምር ጥንቸል በፍጥነት ሮጠች።",
    "flags": []
  },
  {
    "id": "s03",
    "duration_s": 4.781,
    "languages": [
      "amharic"
    ],
    "transcript": "ወደ ኋላም ስትመለከት ኤሊ ገና በጣም ሩቅ ነበረች።",
    "flags": []
  },
  {
    "id": "s04",
    "duration_s": 4.661,
    "languages": [
      "amharic"
    ],
    "transcript": "ጥንቸል በፍጥነቷ በመኩራራት ጊዜ አለኝ ብላ አሰበች።",
    "flags": []
  },
  {
    "id": "s05",
    "duration_s": 6.081,
    "languages": [
      "amharic"
    ],
    "transcript": "ጥንቸል በአንድ ትልቅ ዛፍ ጥላ ስር ትንሽ ልረፍ ብላ ተኛች፤ ነገር ግን ጥልቅ እንቅልፍ ወሰዳት።",
    "flags": []
  },
  {
    "id": "s06",
    "duration_s": 7.051,
    "languages": [
      "amharic"
    ],
    "transcript": "በዚህ ጊዜ ኤሊ ሳትቆም ሳትቸኩል እና ዲሲፕሊን ባለው እርምጃ ወደፊት መጓዟን ቀጠለች።",
    "flags": []
  },
  {
