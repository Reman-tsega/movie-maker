    ],
    "transcript": "በአንድ ፀሐይ ያማቀ ቀን ጥንቸል እና ኤሊ የሩጫ ውድድር ጀመሩ።",
    "flags": []
  },
  {
    "id": "s02",
    "duration_s": 2.77,
    "languages": [
      "Amharic"
    ],
    "transcript": "ውድድሩ ሲጀምር ጥንቸል በከፍተኛ ፍጥነት ሮጠች።",
    "flags": []
  },
  {
    "id": "s03",
    "duration_s": 4.34,
    "languages": [
      "Amharic"
    ],
    "transcript": "ወደ ኋላም ስትመለከት ኤሊ ገና በጣም ሩቅ ነበረች።",
    "flags": []
  },
  {
    "id": "s04",
    "duration_s": 4.5,
    "languages": [
      "Amharic"
    ],
    "transcript": "ጥንቸል በፍጥነቷ በመኮራራት ጊዜ አለኝ ብላ አሰበች።",
    "flags": []
  },
  {
    "id": "s05",
    "duration_s": 9.73,
    "languages": [
      "Amharic"
    ],
    "transcript": "ጥንቸል በአንድ ትልቅ ዛፍ ጥላ ስር ትንሽ ልረፍ ብላ ተኛች ነገር ግን ጥልቅ እንቅልፍ ወሰዳት።",
    "flags": []
  },
  {
    "id": "s06",
    "duration_s": 7.41,
    "languages": [
      "Amharic"
    ],
    "transcript": "በዚህ ጊዜ ኤሊ ሳትቆም ሳትቸኩል በጥንቃቄ ወደፊት መጓዟን ቀጠለች።",
    "flags": []
  },
  {
    "id": "s07",
    "duration_s": 3.66,
    "languages": [
      "Amharic"
    ],
    "transcript": "ጥንቸል ከእንቅልፏ ስትነቃ ጊዜው በጣም ረፍዶ ነበር።",
    "flags": []
  },
  {
    "id": "s08",
    "duration_s": 4.1,
    "languages": [
      "Amharic"
    ],
    "transcript": "ኤሊ የመጨረሻው መስመር አጠገብ ደርሳ ነበረ።",
    "flags": []
  },
  {
    "id": "s09",
    "duration_s": 5.87,
    "languages": [
      "Amharic"
    ],
    "transcript": "ጥንቸል በሙሉ ኃይሏ ብትሮጥም ቀድማ መድረስ አልቻለችም ኤሊ ውድድሩን አሸነፈች።",
